{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Agent Handoff Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "objective_id",
    "task_id",
    "attempt_id",
    "worker_id",
    "tier",
    "role",
    "status",
    "created_at",
    "source_revision",
    "artifacts",
    "verification",
    "usage",
    "blockers",
    "next_action"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "role": {
      "type": "string"
    },
    "status": {
      "enum": [
        "started",
        "progress",
        "completed",
        "failed",
        "blocked",
        "awaiting_final_review",
        "approved",
        "changes_required"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "checks_run",
        "results"
      ],
      "properties": {
        "checks_run": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "cost_source"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "pr_url": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
